# Email Configuration
# You need to set these variables for the chat widget to send emails

# Contact email address (where messages will be sent)
CONTACT_EMAIL=Tom_jake2026@outlook.com

# SMTP Configuration
# For Gmail: Use "smtp.gmail.com" and port 587, with an app-specific password
# For other providers: Configure according to your email service provider
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-specific-password

# Example for Outlook/Hotmail:
# SMTP_HOST=smtp-mail.outlook.com
# SMTP_PORT=587
# SMTP_USER=your-email@outlook.com
# SMTP_PASS=your-password
